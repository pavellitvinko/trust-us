# Copy to .env and fill in. Nothing here is needed for the deterministic layers.

# Where the database, model cache and captures live (a mounted volume in Docker).
FTF_DATA_DIR=./data

# Claude: reading pages and screenshots, pattern discovery, expectation profiles.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
FTF_CLAUDE_MODEL=claude-opus-5-5

# Gemini: text and image embeddings, transcription, video.
# Get a key at https://aistudio.google.com/ (use a paid-tier key; check its data-use terms).
GEMINI_API_KEY=
FTF_EMBEDDING_MODEL=gemini-embedding-2
FTF_VIDEO_MODEL=gemini-4-hydrogen
